# Copie ce fichier en .env et remplis tes valeurs

# Token du bot Telegram (recu de @BotFather sur Telegram)
TELEGRAM_BOT_TOKEN=

# ID du chat/utilisateur qui recoit les notifs (recu via @userinfobot ou l'API getUpdates)
TELEGRAM_CHAT_ID=

# Frequence de scan au format cron (defaut: toutes les 30 min)
CRON_SCHEDULE=*/30 * * * *
